* text=auto

# Mini-repo checksum manifests are expected to be portable across platforms.
# Keep checksum-sensitive text artifacts on LF so Windows clones do not rewrite
# bytes before validation.
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.py text eol=lf
*.csv text eol=lf
*.svg text eol=lf
.python-version text eol=lf
checksums.sha256 text eol=lf

# Binary/reference artifacts must never be line-ending normalized.
*.h5 binary
*.npy binary
*.npz binary
*.pdf binary
*.png binary
*.tif binary
*.tiff binary
*.zip binary
analysis/cellpose/models/a4_cyto2_PhD_1000_new binary
analysis/cellpose/models/a2_cyto3_Epi_1000_PhD binary
.gitattributes text eol=lf
